# Public browser-safe Supabase values for the Vite app. These are the only
# env vars that should be visible in the client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-side secrets stay private and are NOT VITE_-prefixed.
# SUPABASE_SERVICE_ROLE_KEY=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# CRON_SECRET=
