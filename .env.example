# Supabase — public/publishable values, safe to expose in the browser bundle.
# NOTE: this is a Vite app, so vite.config.js sets envPrefix to allow the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
